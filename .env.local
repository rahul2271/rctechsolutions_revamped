# Copy this file to .env.local and fill in real values.
# .env.local is already gitignored by default in Next.js — never commit real keys.

# ── WordPress headless integration (blogs + webinars) ──────────────────────
WORDPRESS_URL=https://darkorchid-swallow-640839.hostingersite.com
# Only needed if your WP site is private:
# WORDPRESS_AUTH=Basic base64(user:app-password)

# ── Razorpay (webinar payments) ─────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# ── WordPress → Next.js revalidation webhook ────────────────────────────────
REVALIDATE_SECRET=some_random_secret_string

# ── Used as a fallback base URL in a couple of server fetches ──────────────
# Also used by the image proxy (app/lib/media.js) to build absolute image
# URLs.
#
# IMPORTANT: this is YOUR NEXT.JS SITE'S OWN URL — NOT the WordPress URL.
# WORDPRESS_URL (above) and NEXT_PUBLIC_SITE_URL are two different domains
# and must never be set to the same value:
#   WORDPRESS_URL        → where your CMS content lives (the Hostinger site)
#   NEXT_PUBLIC_SITE_URL → where THIS Next.js app runs
#
# Setting this to the WordPress URL breaks every image on the site: the
# proxy would build links like
#   https://darkorchid-swallow-640839.hostingersite.com/api/media?url=...
# — but /api/media only exists on your Next.js app. WordPress has no such
# route, so every image request 404s.
#
#   Local development → http://localhost:3000  (current value below)
#   Production        → https://www.rctechsolutions.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Google Search Console ownership verification ────────────────────────────
# Get this from: Search Console → Settings → Ownership verification → HTML tag
# Copy ONLY the content="..." value, not the whole <meta> tag.
# If left blank, the verification meta tag is simply omitted (safer than the
# old hardcoded placeholder that was shipping to production unfilled).
NEXT_PUBLIC_GSC_VERIFICATION=
